# Agent reasoning. Copy this file to `.env` and paste your key after the `=`.
#
# You only need this to RECORD new decisions. `npm run eval` replays the
# committed ones from .cache/llm and needs no key, no network and no quota.
#
# A shell variable takes precedence over anything set here, so an exported
# GEMINI_API_KEY wins over a stale value in this file.
GEMINI_API_KEY=

# Optional: Razorpay test-mode adapter demo (day 9). Never used by the eval path.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
