node_modules/
.env
.env.*
!.env.example
*.log
.DS_Store
.cache/llm/*.tmp

# Regenerable from seed via `npm run gen -- --size 2000 --name stress`; too large to commit.
data/batches/stress.*

# Ad-hoc run directories. Checkpoint and submission runs are committed explicitly
# with `git add -f`, including their gzipped audit ledgers. A re-run at the same
# seed reproduces every hash and every number; the files themselves differ,
# because each record carries the wall clock at which it was written.
results/*/

# Local prompt/preview scratch. Never part of a result.
scratch/
